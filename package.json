{
  "name": "hyperfocus",
  "version": "2.0.0",
  "description": "ADHD-friendly productivity app: zero-friction capture, a focus timer, and a race against your recent selves",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verify": "tsc --noEmit && expo lint && jest",
    "e2e": "node scripts/e2e.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "4.0.7",
